# ---- Optional: vision-language description API (server-side only) ----
# Keys placed here are read ONLY by the Vercel serverless function in /api.
# They are never bundled into the client. Without a key the app falls back
# to grounded local template descriptions and shows an "API unavailable" state.

# OpenAI-compatible chat completions endpoint provider
VISION_API_KEY=
VISION_API_BASE=https://api.openai.com/v1
VISION_API_MODEL=gpt-4o-mini

# Optional: override the object-detection model download URL in the client.
# Default: official Ultralytics YOLOv5s ONNX export (AGPL-3.0).
# VITE_DETECTOR_MODEL_URL=
